@model IEnumerable<Models.Teacher>

@foreach (var teacher in Model)
    {
        <div>
            <a href="/Teachers/Details/@teacher.Id" title="Voir les détails de @teacher.FirstName" style="text-decoration:none; width:100% !important">
                <img class="UserSmallAvatar transparentBackground" src="@teacher.Avatar" />

                <span style="color:blue">
                    @teacher.Code

                </span>
                <span class="teacherLastName" style="color:black">
                    @teacher.LastName

                </span>
                <span style="color:black">
                    @teacher.FirstName

                </span>
                </a>
        </div>



    }