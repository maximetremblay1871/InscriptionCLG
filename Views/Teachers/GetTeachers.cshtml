@model IEnumerable<Models.Teacher>

@foreach (var teacher in Model)
    {
        <div>
            <a href="/Teachers/Details/@teacher.Id" title="Voir les détails de @teacher.FirstName" style="text-decoration:none; width:100% !important">
                <span class="UserSmallAvatar" style="background-image: url('@teacher.Avatar'); border:0.1px solid white; ">

                </span>
                <span>
                    @teacher.Code

                </span>
                <span>
                    @teacher.LastName

                </span>
                <span>
                    @teacher.FirstName

                </span>
                </a>
        </div>



    }