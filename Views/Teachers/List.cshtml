@{ ViewBag.PageTitle = "Profs";
    string search = Session["Search"] != null ? ((bool)Session["Search"]).ToString() : false.ToString();
  
    }

<!--
    The content of this view rely on the one produced
    by the /Contacts/GetContacts action that call
    Views/Contacts/GetContacts.cshtml partial view
-->

<div id="TeachersListPanel" class="teacherListLayout">
    <!-- Periodicaly refreshed by object contactListPanel of class AutoRefreshedPanel -->
</div>

@section Scripts {
    <script>
        let teachersListAutoRefreshPanel = null;

        $(() => {
            newSession(600);
            teachersListAutoRefreshPanel =
                new AutoRefreshedPanel(
                    "TeachersListPanel",
                    "/Teachers/GetTeachers",
                    5,
                    teachersListPostRefresh);

            let keywordsOnchangeTimer = null;

            $("#searchInput").on('keyup', function () {
                clearTimeout(keywordsOnchangeTimer);
                /* delay request by 0.5 seconds */
                keywordsOnchangeTimer = setTimeout(() => {
                    window.location = "/Teachers/SetSearchString?value=" + $("#searchInput").val();
                }, 1000 /* 1 seconds */);
            });
            $("#searchInput").on('search', function () { /* click on clear */
                clearTimeout(keywordsOnchangeTimer);
                window.location = "/Teachers/SetSearchString?value=" + $("#searchInput").val();
            });
            $("#searchInput").on("focus", function () {
                teachersListAutoRefreshPanel.pause();
            });
            $("#searchInput").on("blur", function () {
                teachersListAutoRefreshPanel.restart();
            });

            function teachersListPostRefresh() {

                highlightKeyword()
            }
            function highlightKeyword() {
            if ("@search" == "True") {
                let keyword = $("#searchInput").val();

                if (keyword.length > 0) {
                    let lastNames = document.getElementsByClassName('teacherLastName');
  
                    Array.from(lastNames).forEach(LastName => {
                         highlight(keyword, LastName);
                     });

                }
            }
        }


        })</script>
}