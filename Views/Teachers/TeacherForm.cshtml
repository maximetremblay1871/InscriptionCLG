@model Models.Teacher
@{

}


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken() <!-- Injection de jeton anti contrefaçon de formulaire -->
    <fieldset>
        <legend>Prénom</legend>
        <input id="FirstName"
               name="FirstName"
               class="form-control"
               placeholder="Prénom"
               value="@Model.FirstName"
               required
               RequireMessage="Veuillez entrer un prénom" />
    </fieldset>
    <fieldset>
        <legend>Nom</legend>
        <input id="LastName"
               name="LastName"
               class="form-control"
               placeholder="Nom"
               value="@Model.LastName"
               required
               RequireMessage="Veuillez entrer un nom" />
    </fieldset>
    <fieldset>
        <label for="StartDare" class="form-label">Date d'embauche </label>
        <input name="StartDate" class="form-control datepicker" value="@Model.StartDate"
               required
               RequireMessage="Veuillez entrer une date"
               InvalidMessage="Date invalide" />
    </fieldset>
    <fieldset>
        <label for="Phone" class="form-label">Téléphone </label>
        <input class="form-control Phone"
               name="Phone"
               id="Phone"
               placeholder="(000) 000-0000"
               required
               RequireMessage="Veuillez entrer un téléphone"
               InvalidMessage="Téléphone invalide"
               value="@Model.Phone" />
    </fieldset>
    <fieldset>
        <legend>Avatar</legend>
        @Helper.ImageUploader("Avatar", Model.Avatar, "Cliquez glisser une photo")
    </fieldset>
    <input id="submit" type="submit" value="Enregistrer" class="btn btn-primary" style="display:none">

}
