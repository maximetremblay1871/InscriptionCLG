@model Models.Teacher
@{
    ViewBag.Action = "Create";
    Html.RenderPartial("TeacherForm");
    ViewBag.PageTitle = "Profs - Ajout";
}

@section Scripts { <!-- Cette section ne doit pas être placée dans une vue partielle -->
    <script>$(() => {
            newSession(600);
            // Nécessaire pour la validation des champs de formulaire
            initFormValidation();
            addConflictValidation("/Teachers/CheckConflict", 'StartDate' /* field unicity check */, 'submit' /* form submit button Id */);
        })</script>
}