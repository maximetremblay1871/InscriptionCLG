@model Models.Course
@{
    ViewBag.Action = "SessionChange";
    Html.RenderPartial("SessionForm");
    ViewBag.PageTitle = "Session Courante";
}

@section Scripts { <!-- Cette section ne doit pas être placée dans une vue partielle -->
    <script>
$(() => {
            newSession(600);
            // Nécessaire pour la validation des champs de formulaire
            initFormValidation();
            addConflictValidation("/Courses/CheckConflict", 'Code' /* field unicity check */, 'submit' /* form submit button Id */);
        })</script>
}