@model Models.Course
@{

}


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken() <!-- Injection de jeton anti contrefaçon de formulaire -->
    bool first = true;
    string open = first ? "open" : "";
    first = false;
    <div style="display:grid; grid-template-columns:auto 20px; align-items:start;">
        <details @open>
            <summary>Informations - [@Model.Code]</summary>
            <fieldset>
                <legend>Session</legend>
                <input id="Session"
                       name="Session"
                       class="form-control"
                       type="number"
                       placeholder="1"
                       value="@Model.Session"
                       required
                       RequireMessage="Veuillez entrer une session" />
            </fieldset>
            <fieldset>
                <legend>Sigle</legend>
                <input id="Code"
                       name="Code"
                       class="form-control"
                       placeholder="000-AAA-AA"
                       value="@Model.Code"
                       required
                       RequireMessage="Veuillez entrer un sigle" />
            </fieldset>
            <fieldset>
                <legend>Titre</legend>
                <input id="Title"
                       name="Title"
                       class="form-control"
                       placeholder="Title"
                       value="@Model.Title"
                       required
                       RequireMessage="Veuillez entrer un titre" />
            </fieldset>
            <input id="submit" type="submit" value="Enregistrer" class="btn btn-primary" style="display:none">
        </details>
    </div>
}
