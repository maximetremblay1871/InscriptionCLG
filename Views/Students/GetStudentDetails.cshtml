@model Models.Student

@if (Model != null)
{
    bool first = true;
    string open = first ? "open" : "";


    int connectedId = Models.User.ConnectedUser.Id;
    {
        <div style="display:grid; grid-template-columns:auto 20px; align-items:start;">
            <details @open>
                <summary>
                    <img class="icon small_icon" src="~/Content/UI-Images/graduation-cap.png" />
                    @Model.Fullname
                </summary>
                <dl>
                    <dd>
                        <img class="icon small_icon" src="~/Content/UI-Images/barcode.png" />
                        @Model.Code
                    </dd>
                    <dd>
                        <img class="icon small_icon" src="~/Content/UI-Images/phone.png" />
                        @Model.Phone
                    </dd>
                    <dd>
                        <img class="icon small_icon" src="~/Content/UI-Images/courriel.png" />
                        @Model.Email
                    </dd>
                    <dd>
                        <img class="icon small_icon" src="~/Content/UI-Images/cake-candles.png" />
                        @Model.BirthDate
                    </dd>
                </dl>
            </details>
        </div>
        <hr />

    }
}
else
{
    <h2 style = "color:red" > L'étudiant a été effacé</h2 >
    }