@model Models.Student
@{
    bool creating = ViewBag.Action == "Create";
    string information = creating ? "Informations" : "Informations - [" + @Model.Code + "]";
    string currentSession = Session["CurrentSession"] != null ? (string)Session["CurrentSession"] : "Hiver";
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken() <!-- Injection de jeton anti contrefaçon de formulaire -->
    bool first = true;
    string open = first ? "open" : "";
    first = false;
    <details @open>
        <summary> @information </summary>

        <fieldset>
            <legend>Prénom</legend>
            <input id="FirstName"
                   name="FirstName"
                   class="form-control"
                   placeholder="Prénom"
                   value="@Model.FirstName"
                   required
                   RequireMessage="Veuillez entrer un prénom" />
        </fieldset>

        <fieldset>
            <legend>Nom</legend>
            <input id="LastName"
                   name="LastName"
                   class="form-control"
                   placeholder="Nom"
                   value="@Model.LastName"
                   required
                   RequireMessage="Veuillez entrer un nom" />
        </fieldset>

        <fieldset>
            <label for="BirthDate" class="form-label">Date de naissance </label>
            <input name="BirthDate" class="form-control" value="@(Model.BirthDate == DateTime.MinValue ? "" : Model.BirthDate.ToString("yyyy-MM-dd"))"
                   required
                   type="date"
                   max="@DateTime.Now.ToString("yyyy-MM-dd")"
                   RequireMessage="Veuillez entrer une date"
                   InvalidMessage="Date invalide" />
        </fieldset>

        @if (!creating)
        {
            <fieldset>
                <label for="Email" class="form-label">Courriel </label>
                <input class="form-control Email"
                       name="Email"
                       placeholder="(000) 000-0000"
                       required
                       RequireMessage="Veuillez une adresse email"
                       InvalidMessage="Email invalide"
                       value="@Model.Email" />
            </fieldset>
        }

        <fieldset>
            <label for="Phone" class="form-label">Téléphone </label>
            <input class="form-control Phone"
                   name="Phone"
                   id="Phone"
                   placeholder="(000) 000-0000"
                   required
                   RequireMessage="Veuillez entrer un téléphone"
                   InvalidMessage="Téléphone invalide"
                   value="@Model.Phone" />
        </fieldset>
    </details>


    if (!creating)
    {
    <details open>
        <summary> @currentSession </summary>
            @Helper.SelectionLists("SelectedCoursesId", (SelectList)ViewBag.Registrations, (SelectList)ViewBag.Courses)
    </details>
    }

    <input id="submit" type="submit" value="Enregistrer" class="btn btn-primary" style="display:none">
}
