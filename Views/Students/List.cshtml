@{ ViewBag.PageTitle = "InscriptionCLG"; }

<!--
    The content of this view rely on the one produced
    by the /Contacts/GetContacts action that call
    Views/Contacts/GetContacts.cshtml partial view
-->



<div id="StudentListPanel">
    <!-- Auto Refreshed -->
</div>

@section Scripts {
    <script>
        /*
        let mediasListAutoRefreshPanel = null;
        let categoriesSelectAutoRefreshPanel = null;
        let ownerSelectAutoRefreshPanel = null;
        */
        let studentListAutoRefreshPanel = null;

        
        $(() => {
            newSession(600);

           /*
            categoriesSelectAutoRefreshPanel =
                new AutoRefreshedPanel(
                    "categorySelectPanel",
                    "/Medias/GetMediasCategoriesList",
                    -1, // Manually Refreshed
                    categoriesSelectPostRefresh);
            */

            studentsListAutoRefreshPanel =
                new AutoRefreshedPanel(
                    "StudentListPanel",
                    "/Students/GetStudents",
                    5,
                    studentsListPostRefresh);

            yearsSelectAutoRefreshPanel =
                new AutoRefreshedPanel(
                    "yearSelectPanel",
                    "/Students/GetStudentsYearsList",
                    -1, // Manually Refreshed
                    yearsSelectPostRefresh);

            let keywordsOnchangeTimer = null;

            $("#searchInput").on('keyup', function () {             // searchInput -> dans le header
                clearTimeout(keywordsOnchangeTimer);
                /* delay request by 0.5 seconds */
                keywordsOnchangeTimer = setTimeout(() => {
                    window.location = "/Students/SetSearchString?value=" + $("#searchInput").val();
                }, 1000 /* 1 seconds */);
            });
            $("#searchInput").on('search', function () { /* click on clear */
                clearTimeout(keywordsOnchangeTimer);
                window.location = "/Students/SetSearchString?value=" + $("#searchInput").val();
            });
            $("#searchInput").on("focus", function () {
                studentsListAutoRefreshPanel.pause();
            });
            $("#searchInput").on("blur", function () {
                studentsListAutoRefreshPanel.restart();
            });


            function studentsListPostRefresh() {
                yearsSelectAutoRefreshPanel.refresh(true);        
            }


            function yearsSelectPostRefresh() {

                $("#yearSelect").off();
                $("#yearSelect").on("focus", function () {
                    studensListAutoRefreshPanel.pause();
                });
                $("#yearSelect").on("blur", function () {
                    studentsListAutoRefreshPanel.restart();
                });
                $("#yearSelect").on('change', function () {
                    window.location = "/Students/SetSearchYear?value=" + $("#yearSelect").val();
                });
            }
        })
    </script>
}