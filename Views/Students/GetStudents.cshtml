@model IEnumerable<Models.Student>

@{ 
    var yearsList = ((List<int>)Session["StudentYearsList"]).OrderByDescending(i => i);
}


@foreach (int year in yearsList)
{
    var students = Model.Where(s => s.Year == year);
    if(students.Count() > 0)
    {
        <details id="student_details_@year">
            <summary>Cohorte @year</summary>
            @foreach (var student in students)
            {
                <div class="StudentListLayout">
                    <a href="@Url.Action("Details", new {id = student.Id})">
                        <div style="display:flex">
                            <span class="studentCode">@student.Code</span>
                            <div class="studentName">@student.LastName @student.FirstName</div>
                        </div>
                    </a>
                </div>
            }
        </details>    
    }
}
